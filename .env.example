# Ollama (padrão)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3:8b
OLLAMA_TOOLS=1

# Moonshot / Kimi
MOONSHOT_API_KEY=
KIMI_MODEL=kimi-k3

# OpenAI (opcional — o provedor só aparece se a chave existir)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# PostgreSQL (opcional — sem DATABASE_URL usa arquivos .pkf/)
# DATABASE_URL=postgresql+asyncpg://pkf:pkf@localhost:5432/pkf

# 9Router híbrido (opcional — pool free maior)
# NINEROUTER_URL=http://127.0.0.1:20128
# PKF_PROVIDER=ninerouter
# NINEROUTER_MODEL=oc/big-pickle
