# Ollama (padrão)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3:8b
OLLAMA_TOOLS=1

# Moonshot / Kimi
MOONSHOT_API_KEY=
KIMI_MODEL=kimi-k3

# DeepSeek / R1 (reasoning — architect, reviewer, logic)
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_REASONER_MODEL=deepseek-reasoner
# PKF_REASONING_MODEL=deepseek-reasoner
# PKF_REASONING_AGENTS=architect,reviewer,logic
# PKF_REASONING_TEMPERATURE=0.6
# PKF_WEB_SEARCH_FORMAT=deepseek

# OpenAI (opcional — o provedor só aparece se a chave existir)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL (opcional — sem DATABASE_URL usa arquivos .pkf/)
# DATABASE_URL=postgresql+asyncpg://pkf:pkf@localhost:5432/pkf

# 9Router híbrido (opcional — pool free maior)
# NINEROUTER_URL=http://127.0.0.1:20128
# PKF_PROVIDER=ninerouter
# NINEROUTER_MODEL=oc/big-pickle

# Headroom — compressão de contexto via proxy OpenAI-compatible (opt-in)
# pip install "headroom-ai[proxy]" && headroom proxy --port 8788
# PKF_HEADROOM_PROXY_URL=http://127.0.0.1:8788/v1

# Tier de qualidade — Claude via 9Router/gateway (architect + reviewer apenas)
# PKF_TIER_QUALITY=ninerouter
# PKF_QUALITY_MODEL=kr/claude-sonnet-4.5

# Build via grafo piloto (paralelo ao pipeline clássico)
# PKF_USE_LANGGRAPH_BUILD=1
