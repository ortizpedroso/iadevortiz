# Produção na VPS (Hostinger) — copie para .env na VPS
PKF_ENV=production
PKF_PROVIDER=kimi
PKF_HOST=0.0.0.0
PKF_PORT=8765
PKF_NO_BROWSER=1

# Obrigatório: chave da API (não use Ollama na VPS — consome muita RAM)
MOONSHOT_API_KEY=sua_chave_aqui
KIMI_MODEL=kimi-k3

# Proteção de acesso (gere um token forte)
PKF_AUTH_TOKEN=troque-por-um-token-longo-e-seguro

# OpenAI (alternativa ao Kimi)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Sem fallback para Ollama em produção
PKF_FALLBACK=
