# Produção na VPS (Hostinger) — copie para .env na VPS
PKF_ENV=production
PKF_HOST=0.0.0.0
PKF_PORT=8765
PKF_NO_BROWSER=1

DATABASE_URL=postgresql+asyncpg://pkf:pkf@postgres:5432/pkf

# --- Modo híbrido: 9Router (primário) + router nativo (fallback) ---
# Com profile router: docker compose --profile router up -d
# NINEROUTER_URL=http://ninerouter:20128
# PKF_PROVIDER=ninerouter
# NINEROUTER_KEY=local          # ou copie a chave do dashboard 9Router
# NINEROUTER_MODEL=oc/big-pickle

# --- Router nativo (tiers + multi-chave) — fallback direto ---
PKF_PROVIDER=groq
PKF_PROVIDER_TIERS=subscription,cheap,free
PKF_TIER_SUBSCRIPTION=groq
PKF_TIER_CHEAP=gemini
PKF_TIER_FREE=groq
PKF_PROVIDER_POOL=groq,gemini

GROQ_API_KEY=sua_chave_groq
GROQ_API_KEY_2=                    # opcional: segunda conta Groq
GROQ_MODEL=llama-3.1-8b-instant
PKF_GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# GEMINI_API_KEY=
# MOONSHOT_API_KEY=

# Web search (tool web_search)
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=

PKF_AUTH_TOKEN=troque-por-um-token-longo-e-seguro
PKF_FALLBACK=
