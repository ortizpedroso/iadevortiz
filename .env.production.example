# Produção na VPS (Hostinger) — copie para .env na VPS
PKF_ENV=production
PKF_HOST=0.0.0.0
PKF_PORT=8765
PKF_NO_BROWSER=1

DATABASE_URL=postgresql+asyncpg://pkf:pkf@postgres:5432/pkf

# --- Modo router-only (padrão): OmniRoute + tokens só do gateway ---
# Com profile router: docker compose --profile router up -d
ROUTER_IMAGE=diegosouzapw/omniroute:latest
PKF_ROUTER_ONLY=1
NINEROUTER_URL=http://ninerouter:20128
PKF_PROVIDER=ninerouter
PKF_PROVIDER_POOL=ninerouter
PKF_TIER_SUBSCRIPTION=ninerouter
PKF_TIER_CHEAP=ninerouter
PKF_TIER_FREE=ninerouter
# NINEROUTER_KEY=sk-...   # gerado por deploy/hostinger/fix-ninerouter-key.sh
NINEROUTER_MODEL=oc/big-pickle

# Tier de qualidade (architect/reviewer) — modelos via OmniRoute
# PKF_TIER_QUALITY=ninerouter
# PKF_QUALITY_MODEL=kr/claude-sonnet-4.5

# --- Modo híbrido (opcional): desative router-only e adicione chaves diretas ---
# PKF_ROUTER_ONLY=0
# GROQ_API_KEY=sua_chave_groq
# GEMINI_API_KEY=sua_chave_gemini

PKF_AUTH_TOKEN=troque-por-um-token-longo-e-seguro
PKF_FALLBACK=
