# Produção na VPS (Hostinger) — copie para .env na VPS
PKF_ENV=production
PKF_PROVIDER=kimi
PKF_HOST=0.0.0.0
PKF_PORT=8765
PKF_NO_BROWSER=1

# Obrigatório: chave da API (não use Ollama na VPS — consome muita RAM)
MOONSHOT_API_KEY=sua_chave_aqui
KIMI_MODEL=kimi-k3

# Proteção de acesso (gere um token forte)
PKF_AUTH_TOKEN=troque-por-um-token-longo-e-seguro

# Groq (grátis) via compatibilidade OpenAI
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.1-8b-instant
# PKF_BUILD_MODEL=llama-3.1-8b-instant
# PKF_SPEC_MODEL=llama-3.3-70b-versatile

# Gemini (grátis, alternativa quando Groq estoura limite)
# PKF_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Sem fallback para Ollama em produção
PKF_FALLBACK=
