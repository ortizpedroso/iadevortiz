# Produção na VPS (Hostinger) — copie para .env na VPS
PKF_ENV=production
PKF_PROVIDER=kimi
PKF_HOST=0.0.0.0
PKF_PORT=8765
PKF_NO_BROWSER=1

# Obrigatório: chave da API (não use Ollama na VPS — consome muita RAM)
MOONSHOT_API_KEY=sua_chave_aqui
KIMI_MODEL=kimi-k3

# Proteção de acesso (gere um token forte)
PKF_AUTH_TOKEN=troque-por-um-token-longo-e-seguro

# Pool de provedores grátis — rotação automática em rate limit (não para o dev)
# PKF_PROVIDER=groq
# PKF_PROVIDER_POOL=groq,gemini,kimi
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# MOONSHOT_API_KEY=

# Sem fallback para Ollama em produção
PKF_FALLBACK=
